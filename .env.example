# =============================================================================
# VoiceAI Environment Variables Template
# =============================================================================
# Copy this file to .env.local and populate with your own project credentials:
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SIDE FIREBASE WEB CONFIGURATION (Required)
# Safe to expose to the browser via NEXT_PUBLIC_* prefix.
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>) -> Config
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Public application base URL (Used for generating assistant share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# SERVER-SIDE AI INTEGRATION (Required for live AI chat)
# DO NOT prefix with NEXT_PUBLIC_ (Must remain private to server-side API routes).
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here

# -----------------------------------------------------------------------------
# SERVER-SIDE FIREBASE ADMIN SDK (Optional for local development)
# Only required in production server environments requiring privileged Admin SDK access.
# If omitted in local dev, the app safely defaults to client-side Firestore/Auth rules.
# Obtain from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_lines_here\n-----END PRIVATE KEY-----\n"
